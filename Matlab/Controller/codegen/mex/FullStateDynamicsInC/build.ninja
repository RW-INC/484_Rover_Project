# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = C:/Program Files/MATLAB/R2025b
startdir = C:/Users/srikr/Desktop/SPARX/Matlab/Controller

# Toolchain information
cc = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
cxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++
linker = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
linkerxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "C:\Users\srikr\Desktop\SPARX\Matlab\Controller\codegen\mex\FullStateDynamicsInC" -I "C:\Users\srikr\Desktop\SPARX\Matlab\Controller" -I "C:\Users\srikr\Desktop\SPARX\Matlab\Controller\codegen\mex\FullStateDynamicsInC\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DMODEL=FullStateDynamicsInC_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "C:\Users\srikr\Desktop\SPARX\Matlab\Controller\codegen\mex\FullStateDynamicsInC" -I "C:\Users\srikr\Desktop\SPARX\Matlab\Controller" -I "C:\Users\srikr\Desktop\SPARX\Matlab\Controller\codegen\mex\FullStateDynamicsInC\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DMODEL=FullStateDynamicsInC_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

ldflags = FullStateDynamicsInC.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -o "FullStateDynamicsInC_mex.mexw64" -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

ldxxflags = FullStateDynamicsInC.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -llibMatlabDataArray -llibMatlabEngine  -o "FullStateDynamicsInC_mex.mexw64" -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/FullStateDynamicsInC_data.o : cc $root/FullStateDynamicsInC_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/FullStateDynamicsInC_initialize.o : cc $root/FullStateDynamicsInC_initialize.c
build $builddir/FullStateDynamicsInC_terminate.o : cc $root/FullStateDynamicsInC_terminate.c
build $builddir/FullStateDynamicsInC.o : cc $root/FullStateDynamicsInC.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/_coder_FullStateDynamicsInC_api.o : cc $root/interface/_coder_FullStateDynamicsInC_api.c
build $builddir/_coder_FullStateDynamicsInC_mex.o : cc $root/interface/_coder_FullStateDynamicsInC_mex.c
build $builddir/_coder_FullStateDynamicsInC_info.o : cc $root/interface/_coder_FullStateDynamicsInC_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root\FullStateDynamicsInC_mex.mexw64 : link $builddir/FullStateDynamicsInC_data.o $builddir/rt_nonfinite.o $builddir/FullStateDynamicsInC_initialize.o $builddir/FullStateDynamicsInC_terminate.o $builddir/FullStateDynamicsInC.o $builddir/warning.o $builddir/_coder_FullStateDynamicsInC_api.o $builddir/_coder_FullStateDynamicsInC_mex.o $builddir/_coder_FullStateDynamicsInC_info.o $builddir/c_mexapi_version.o 
