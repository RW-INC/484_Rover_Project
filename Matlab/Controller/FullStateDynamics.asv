function full_state_next = FullStateDynamics(full_state_prev, u, dt, terrain, geom)
    x = full_state_prev(1);
    y = full_state_prev(2);
    z = full_state_prev(3);

    roll  = full_state_prev(4);
    pitch = full_state_prev(5);
    yaw   = full_state_prev(6);

    velx = full_state_prev(7);
    vely = full_state_prev(8);
    velz = full_state_prev(9);

    angx = full_state_prev(10);
    angy = full_state_prev(11);
    angz = full_state_prev(12);
    
    w_r = u(1);
    w_l = u(2);

    % kinematics model -> assumes mu_r and mu_l are 1.0
    dx   = (geom.r)/2 * cos(yaw) * (w_r + w_l);
    dy   = (geom.y)/2 * sin(yaw) * (w_r + w_l);
    dyaw = (geom.r)/(geom.B) * (w_r - w_l);

    % Get the current wheel positions
    body_frame_wheels = [ L/2   L/2  -L/2  -L/2;    % x_body
                        -B/2   B/2  -B/2   B/2];  % y_body
    R = [cos(yaw), -sin(yaw) ; sin(yaw), cos(yaw)];

    lunar_frame_wheels = R * body_frame_wheels + [x,y]; % f

end