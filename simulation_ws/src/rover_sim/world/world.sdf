<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="south_pole_world">

    <gravity>0 0 -1.622</gravity> <!-- for lunar gravity -->

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- scene settings -->
    <scene>
      <!-- Lunar ambient is very low because there is no air to scatter light -->
      <ambient>0.05 0.05 0.05 1.0</ambient>
      <background>0.0 0.0 0.0 1.0</background>
      <grid>false</grid>
      <shadows>true</shadows>

    </scene>

    <!-- 1. Handles the math/physics for your controller -->
    <plugin filename="libgz-sim-physics-system.so" name="gz::sim::systems::Physics" />
    
    <!-- 2. Sends visual data to the GUI so you can see markers -->
    <plugin filename="libgz-sim-scene-broadcaster-system.so" name="gz::sim::systems::SceneBroadcaster" />
    
    <!-- 3. Required for processing user and marker commands -->
    <plugin filename="libgz-sim-user-commands-system.so" name="gz::sim::systems::UserCommands" />

    <!-- sun unsure if this is working tbh -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <!-- Intense white light characteristic of the moon's surface -->
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <intensity>2.0</intensity>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-1.5 0.1 -1.0</direction>
    </light>

    <!-- Terrain Model -->
    <model name="lunar_terrain">
      <static>true</static>
      <!-- X Y Z Roll Pitch Yaw -->
      <pose>0 0 0 1.5708 0 0</pose> <!-- change z here to move the terrain up and down -->
      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://src/rover_sim/world/meshes/6221_forced_scale.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>0xffff</collide_bitmask>
            </contact>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://src/rover_sim/world/meshes/6221_forced_scale.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
