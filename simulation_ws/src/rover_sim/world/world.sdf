<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="lunar_world">

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 1000 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <!-- Lunar terrain -->
    <model name="lunar_surface">
      <static>true</static>

      <link name="terrain_link">

        <!-- COLLISION (physics) -->
        <collision name="collision">
          <geometry>
            <heightmap>

            <!-- ADD HEIGHMAT URI HERE-->
              <uri>file:///home/pearluva/Documents/484_Rover_Project/484_Rover_Project/simulation_ws/src/rover_sim/world/media/heightmaps/heightmap_fixed.png</uri>

              <!-- SCALE -->
              <size> 100 100 30 </size>

              <!-- Position offset -->
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>

          <!-- surface friction -->
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <!-- VISUAL -->
        
        <visual name="visual">
          <geometry>
            <heightmap>
            <!-- ADD HEIGHMAT URI HERE-->
              <uri>file:///home/pearluva/Documents/484_Rover_Project/484_Rover_Project/simulation_ws/src/rover_sim/world/media/heightmaps/heightmap_fixed.png</uri>
              <size>100 100 10</size>
            </heightmap>
          </geometry>

          <!-- just gray for now -->
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      

      </link>
    </model>

  </world>
</sdf>