# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = C:/Program Files/MATLAB/R2025b
startdir = C:/Users/srikr/Desktop/SPARX/Controller

# Toolchain information
cc = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
cxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++
linker = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
linkerxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "C:\Users\srikr\Desktop\SPARX\Controller\codegen\mex\smc_core_loop" -I "C:\Users\srikr\Desktop\SPARX\Controller" -I "C:\Users\srikr\Desktop\SPARX\Controller\codegen\mex\smc_core_loop\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DMODEL=smc_core_loop_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "C:\Users\srikr\Desktop\SPARX\Controller\codegen\mex\smc_core_loop" -I "C:\Users\srikr\Desktop\SPARX\Controller" -I "C:\Users\srikr\Desktop\SPARX\Controller\codegen\mex\smc_core_loop\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DMODEL=smc_core_loop_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

ldflags = smc_core_loop.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -o "smc_core_loop_mex.mexw64" -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

ldxxflags = smc_core_loop.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -llibMatlabDataArray -llibMatlabEngine  -o "smc_core_loop_mex.mexw64" -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/smc_core_loop_data.o : cc $root/smc_core_loop_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/smc_core_loop_initialize.o : cc $root/smc_core_loop_initialize.c
build $builddir/smc_core_loop_terminate.o : cc $root/smc_core_loop_terminate.c
build $builddir/smc_core_loop.o : cc $root/smc_core_loop.c
build $builddir/tic.o : cc $root/tic.c
build $builddir/randn.o : cc $root/randn.c
build $builddir/eml_randn.o : cc $root/eml_randn.c
build $builddir/eml_rand.o : cc $root/eml_rand.c
build $builddir/eml_rand_mt19937ar_stateful.o : cc $root/eml_rand_mt19937ar_stateful.c
build $builddir/eml_rand_mt19937ar.o : cc $root/eml_rand_mt19937ar.c
build $builddir/toc.o : cc $root/toc.c
build $builddir/eml_rand_mcg16807_stateful.o : cc $root/eml_rand_mcg16807_stateful.c
build $builddir/eml_rand_shr3cong_stateful.o : cc $root/eml_rand_shr3cong_stateful.c
build $builddir/_coder_smc_core_loop_api.o : cc $root/interface/_coder_smc_core_loop_api.c
build $builddir/_coder_smc_core_loop_mex.o : cc $root/interface/_coder_smc_core_loop_mex.c
build $builddir/smc_core_loop_emxutil.o : cc $root/smc_core_loop_emxutil.c
build $builddir/_coder_smc_core_loop_info.o : cc $root/interface/_coder_smc_core_loop_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root\smc_core_loop_mex.mexw64 : link $builddir/smc_core_loop_data.o $builddir/rt_nonfinite.o $builddir/smc_core_loop_initialize.o $builddir/smc_core_loop_terminate.o $builddir/smc_core_loop.o $builddir/tic.o $builddir/randn.o $builddir/eml_randn.o $builddir/eml_rand.o $builddir/eml_rand_mt19937ar_stateful.o $builddir/eml_rand_mt19937ar.o $builddir/toc.o $builddir/eml_rand_mcg16807_stateful.o $builddir/eml_rand_shr3cong_stateful.o $builddir/_coder_smc_core_loop_api.o $builddir/_coder_smc_core_loop_mex.o $builddir/smc_core_loop_emxutil.o $builddir/_coder_smc_core_loop_info.o $builddir/c_mexapi_version.o 
